# Copy this file to .env.local (ignored by git) and fill in your own values.
# Never commit real keys. VITE_* values are embedded in the client bundle.

# NASA API key from https://api.nasa.gov/ (optional: falls back to the rate-limited DEMO_KEY)
VITE_NASA_API_KEY=

# Clerk publishable key (only needed if the Clerk sign-in page in src/Authentication.jsx is re-enabled)
VITE_CLERK_PUBLISHABLE_KEY=
